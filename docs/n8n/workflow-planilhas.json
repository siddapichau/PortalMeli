      ],
      "webhookId": "a1000000-0000-4000-8000-000000000006"
    },
    {
      "parameters": {
        "jsCode": "// Valida o payload de escrita. `id` é o número da linha na aba informada (campo _idNum das telas).\nconst body = $input.first().json.body || $input.first().json;\nconst spreadsheetId = String(body.spreadsheetId || '').trim();\nconst nomeAba = String(body.nomeAba || '').trim();\nconst coluna = String(body.coluna || '').trim();\nconst id = body.id;\nif (!/^[A-Za-z0-9_-]{30,60}$/.test(spreadsheetId)) {\n  return [{ json: { erro: 'Informe o spreadsheetId da planilha.' } }];\n}\nif (!nomeAba || !coluna || id === undefined || id === null || id === '') {\n  return [{ json: { erro: 'Informe nomeAba, id e coluna para atualizar a célula.' } }];\n}\nreturn [{ json: { spreadsheetId, nomeAba, id, coluna, valor: body.valor === undefined ? '' : body.valor } }];"
      },
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Validar escrita",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -300,
        140
      ]
    },
    {
      "parameters": {
        "jsCode": "// Depois de gravar (nó Google Sheets \"Update\"), responda sucesso ou erro de negócio.\n// As telas leem o campo `erro`; responda HTTP 4xx/5xx em caso de falha real.\nreturn [{ json: { success: true } }];"
      },
