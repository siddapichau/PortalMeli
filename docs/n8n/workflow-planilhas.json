        -80,
        -120
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "SUBSTITUA_PELA_CREDENCIAL",
          "name": "Google Sheets — planilha de teste"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Monta a resposta no contrato esperado pelo frontend.\nconst abas = $input.all().map(item => item.json.title || item.json.name || '').filter(Boolean);\nconst abaAtiva = $('Validar entrada').first().json.abaSolicitada || abas[0] || '';\nreturn [{\n  json: {\n    abaAtiva,\n    abas,\n    dadosCompletos: [],\n    dadosDashboard: [],\n    avisos: ['Workflow padrão: conecte a leitura da aba escolhida ao nó \"Ler aba\" antes de usar em produção.']\n  }\n}];"
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Montar resposta ler-planilha",
