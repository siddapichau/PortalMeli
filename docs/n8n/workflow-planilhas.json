    {
      "parameters": {
        "jsCode": "// Lê a planilha e devolve o contrato consumido por dashboard.html, analise.html e a1.html.\n// Requer a credencial Google Sheets configurada no nó seguinte.\nconst body = $input.first().json.body || $input.first().json;\nconst spreadsheetId = String(body.spreadsheetId || '').trim();\nif (!/^[A-Za-z0-9_-]{30,60}$/.test(spreadsheetId)) {\n  return [{ json: { erro: 'Informe o spreadsheetId da planilha.' } }];\n}\nconst abaSolicitada = String(body.nomeAba || '').trim();\nreturn [{ json: { spreadsheetId, abaSolicitada } }];"
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Validar entrada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -300,
        -120
      ]
    },
    {
      "parameters": {
        "resource": "spreadsheet",
        "operation": "getMany",
        "documentId": {
          "__rl": true,
          "value": "={{ $json.spreadsheetId }}",
          "mode": "id"
        },
        "returnAll": true,
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Google Sheets (abas)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
